{
  "name": "announcord",
  "version": "2.0.0",
  "description": "Discord bot that announces who joins and leaves voice channels",
  "license": "MIT",
  "author": "Armando Locay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "register": "tsx --env-file=.env src/discord/registerCommands.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1146.0",
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "kysely": "^0.29.6",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
