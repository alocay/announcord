# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# IAM user limited to polly:SynthesizeSpeech and polly:DescribeVoices
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Comma-separated guild ids that always get Polly speech with no quota
UNLIMITED_GUILD_IDS=

# Optional: register slash commands to this guild only (instant updates while developing)
DEV_GUILD_ID=

# Optional tuning
DATA_DIR=./data
IDLE_LEAVE_SECONDS=60
CACHE_MAX_MB=200
LOG_LEVEL=info
